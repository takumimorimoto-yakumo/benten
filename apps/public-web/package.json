{
  "name": "@benten/public-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:local",
    "build:local": "node tools/build-local-web.mjs",
    "build:capsule": "BENTEN_PUBLIC_WEB_BUILD_DIRECTORY=build-capsule react-router build",
    "build:host": "pnpm exec tsc -p tsconfig.host.json",
    "dev:catalog": "BENTEN_PUBLIC_WEB_DEV_CATALOG=1 react-router dev --host 127.0.0.1 --strictPort",
    "test:artifact": "node tests/static-artifact.test.mjs",
    "test:capsule": "pnpm run test:foundation && pnpm run build:capsule && pnpm run build:host && pnpm run test:artifact && node --test tests/http-capsule.test.mjs",
    "test:local": "pnpm run test:foundation && node --test tests/local-output-ownership.test.mjs && pnpm run build:local && pnpm run build:local && pnpm run build:host && BENTEN_PUBLIC_WEB_CLIENT_DIRECTORY=.generated/local-web/output/client pnpm run test:artifact && BENTEN_PUBLIC_WEB_CLIENT_DIRECTORY=.generated/local-web/output/client node --test tests/http-capsule.test.mjs && node --test tests/local-proxy.test.mjs",
    "test:foundation": "vitest run --config vitest.config.mjs",
    "typecheck": "pnpm exec tsc -p tsconfig.json"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@benten/holdings": "workspace:*",
    "@benten/mcp": "workspace:*",
    "@benten/pricing": "workspace:*",
    "@benten/purchase": "workspace:*",
    "@benten/registry": "workspace:*",
    "@benten/solana": "workspace:*",
    "@benten/solana-rpc-relay": "workspace:*",
    "@fontsource-variable/geist": "5.3.0",
    "@react-router/node": "7.18.4",
    "@solana-mobile/wallet-standard-mobile": "0.6.0",
    "buffer": "6.0.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "isbot": "5.2.2",
    "lucide-react": "1.47.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "7.18.4",
    "recharts": "3.8.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "7.18.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.4",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
