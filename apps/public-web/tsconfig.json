{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": { "@/*": ["./app/*"] }
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", "ingress/**/*.ts", "react-router.config.ts", "vite.config.ts"]
}
