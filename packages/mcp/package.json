{
  "name": "@benten/mcp",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "smoke": "pnpm run build && node dist/smoke.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@benten/pricing": "workspace:*",
    "@benten/registry": "workspace:*",
    "@benten/solana": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@solana/web3.js": "^1.99.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "vitest": "^5.0.0"
  }
}
