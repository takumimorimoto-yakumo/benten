{
  "name": "@benten/registry",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lookup": {
      "types": "./dist/registry-lookup.d.ts",
      "default": "./dist/registry-lookup.js"
    },
    "./search": {
      "types": "./dist/search.d.ts",
      "default": "./dist/search.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run src"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "vitest": "^5.0.0"
  }
}
