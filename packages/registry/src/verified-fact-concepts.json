  "calculated_items_description": "Values computed from the reported values above, never reported by the filing. A calculated value exists only when every input exists in the same fiscal year; for 'divide' the denominator must be greater than zero. Ratios are fractions rounded to six decimal places. A calculated value inherits 'unverified_or_derived' when any input has that status.",
  "calculated_items": {
    "gross_margin": {
      "statement": "pl",
      "unit": "ratio",
      "label": "Gross margin",
      "operation": "divide",
      "inputs": [
        "gross_profit",
        "revenue"
      ],
      "formula": "gross_profit / revenue",
      "note": "Both inputs are duration values of the same fiscal year."
    },
    "operating_margin": {
      "statement": "pl",
      "unit": "ratio",
      "label": "Operating margin",
      "operation": "divide",
      "inputs": [
        "operating_income",
        "revenue"
      ],
      "formula": "operating_income / revenue",
      "note": "Both inputs are duration values of the same fiscal year."
    },
    "net_margin": {
      "statement": "pl",
      "unit": "ratio",
      "label": "Net margin (parent)",
      "operation": "divide",
      "inputs": [
        "net_income_parent",
        "revenue"
      ],
      "formula": "net_income_parent / revenue",
      "note": "Uses net income attributable to the parent."
    },
    "return_on_equity": {
      "statement": "pl",
      "unit": "ratio",
      "label": "Return on equity (year-end equity)",
      "operation": "divide",
      "inputs": [
        "net_income_parent",
        "equity_parent"
      ],
      "formula": "net_income_parent / equity_parent",
      "note": "Uses equity at the end of the fiscal year, not an average."
    },
    "return_on_assets": {
      "statement": "pl",
      "unit": "ratio",
      "label": "Return on assets (year-end assets)",
      "operation": "divide",
      "inputs": [
        "net_income_parent",
        "total_assets"
      ],
      "formula": "net_income_parent / total_assets",
      "note": "Uses total assets at the end of the fiscal year, not an average."
    },
    "equity_ratio": {
      "statement": "bs",
      "unit": "ratio",
      "label": "Equity ratio",
      "operation": "divide",
      "inputs": [
        "equity_parent",
        "total_assets"
      ],
      "formula": "equity_parent / total_assets",
      "note": "Parent equity over total assets at the same date."
    },
    "current_ratio": {
      "statement": "bs",
      "unit": "ratio",
      "label": "Current ratio",
      "operation": "divide",
      "inputs": [
        "current_assets",
        "current_liabilities"
      ],
      "formula": "current_assets / current_liabilities",
      "note": "Both at the same date."
    },
    "free_cash_flow": {
      "statement": "cf",
      "unit": "USD",
      "label": "Free cash flow (operating cash flow minus capital expenditure)",
      "operation": "subtract",
      "inputs": [
        "operating_cf",
        "capex"
      ],
      "formula": "operating_cf - capex",
      "note": "capex is the reported positive payment for property, plant and equipment. Free-cash-flow measures have no uniform definition; this one is exactly the stated formula."
    }
  }
}
