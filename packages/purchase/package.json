{
  "name": "@benten/purchase",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Framework-independent browser purchase logic for the fixed NVDAx/USDC route. Consumed from source by bundlers; nothing here signs or sends.",
  "exports": {
    "./server-quote": {
      "types": "./src/server-quote.ts",
      "default": "./dist/server-quote.js"
    },
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "node scripts/build-server-quote.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run src"
  },
  "dependencies": {
    "@benten/solana": "workspace:*",
    "@benten/solana-rpc-relay": "workspace:*",
    "@meteora-ag/dlmm": "1.9.14",
    "@solana/web3.js": "^1.99.0",
    "@wallet-standard/app": "1.1.1",
    "@wallet-standard/base": "1.1.1",
    "bn.js": "^5.2.1"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.6",
    "@types/node": "^24.7.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  }
}
